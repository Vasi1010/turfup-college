# Copy to .env and adjust. docker-compose reads this file automatically.
POSTGRES_DB=turfup
POSTGRES_USER=turfup
POSTGRES_PASSWORD=turfup
POSTGRES_PORT=5432

# The backend reads these (defaults in application.yml match the values above).
DB_URL=jdbc:postgresql://localhost:5432/turfup
DB_USER=turfup
DB_PASSWORD=turfup

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
