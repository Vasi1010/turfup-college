# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in every value.

# Public domain; its DNS must point at this machine. Caddy gets the HTTPS certificate for it.
DOMAIN=

# Database (only reachable inside the compose network). Use a long random password.
POSTGRES_DB=turfup
POSTGRES_USER=turfup
POSTGRES_PASSWORD=

# JWT signing key, at least 32 characters: openssl rand -base64 48
JWT_SECRET=

# Your own phone, registered in the app as a player first: it becomes the admin on the next start.
TURFUP_ADMIN_PHONE=

# Cricket tournaments with live scoring (docs/tournament.md): true while one is on.
TURFUP_TOURNAMENTS_ENABLED=false

# Days of daily database backups kept in ./backups (the backup service).
BACKUP_KEEP_DAYS=14

# Leave empty: the frontend and /api share one origin. List extra origins only if another site must call the API.
CORS_ALLOWED_ORIGINS=

# Error reporting (optional). Empty = off. Backend and frontend use separate Sentry projects/DSNs.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# simulated | razorpay. In razorpay mode all three RAZORPAY_* values are required (the backend will not start
# without them). Test-mode keys start with rzp_test_. See docs/razorpay-test-mode.md.
TURFUP_PAYMENTS_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in the Razorpay dashboard (https://<DOMAIN>/api/payments/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
